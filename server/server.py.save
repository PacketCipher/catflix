#!/usr/bin/env python3
"""
CatFlix VPS Server – Final Production Edition (All Fixes)

- Reuses persistent ClientSession per origin to avoid resource exhaustion.
- Global lock protecting session dictionaries for full concurrency safety.
- All session buffer accesses are protected by per‑session locks.
- WebSocket client sessions properly closed.
- All previous improvements retained.
"""

import asyncio, base64, logging, os, random, secrets, socket, struct, sys, time
from collections import defaultdict
from urllib.parse import urlparse
from aiohttp import web, ClientSession, ClientTimeout, WSMsgType
import brotli
import msgpack
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
from cryptography.hazmat.backends import default_backend

# ============================================================
# Configuration
# ============================================================
AES_KEY = base64.b64decode(os.environ["AES_KEY_B64"])
BROTLI_QUALITY = int(os.environ.get("BROTLI_QUALITY", 6))
SESSION_TIMEOUT = int(os.environ.get("SESSION_TIMEOUT", 120))
MAX_ENCRYPTED_SIZE = 40 * 1024 * 1024
MIN_RESP_PAD = int(os.environ.get("MIN_RESP_PAD", 256))
CHUNK_SIZE_DOWNLOAD = 10 * 1024 * 1024
LONG_POLL_TIMEOUT = 25
PARALLEL_RANGE_MAX = 8

logging.basicConfig(stream=sys.stderr, level=logging.INFO,
                    format="[SERVER] %(asctime)s %(levelname)s %(message)s")
log = logging.getLogger("CatFlix")

# ============================================================
# Crypto & Compression
# ============================================================
def aes_enc(p: bytes) -> bytes:
    n = secrets.token_bytes(12)
    c = Cipher(algorithms.AES(AES_KEY), modes.GCM(n), backend=default_backend()).encryptor()
    return n + c.update(p) + c.finalize() + c.tag

def aes_dec(p: bytes) -> bytes:
    n, t = p[:12], p[-16:]
    ct = p[12:-16]
    d = Cipher(algorithms.AES(AES_KEY), modes.GCM(n, t), backend=default_backend()).decryptor()
    return d.update(ct) + d.finalize()

def compress(data: bytes) -> bytes:
    return brotli.compress(data, quality=BROTLI_QUALITY)

def decompress(data: bytes) -> bytes:
    return brotli.decompress(data)

def pad_response(enc: bytes) -> bytes:
    if len(enc) < MIN_RESP_PAD:
        enc += secrets.token_bytes(MIN_RESP_PAD - len(enc))
    return struct.pack(">I", len(enc)) + enc

# ============================================================
# Session containers (all with 'lock') – global lock for dicts
# ============================================================
tcp_sessions: dict[str, dict] = {}
udp_sessions: dict[str, dict] = {}
ws_sessions: dict[str, dict] = {}
stream_sessions: dict[str, dict] = {}
UPLOAD_BUFFERS: dict[str, dict] = {}

sessions_global_lock = asyncio.Lock()

# Persistent client sessions per origin
origin_sessions: dict[str, ClientSession] = {}
origin_lock = asyncio.Lock()

async def get_client_for_origin(origin: str) -> ClientSession:
    async with origin_lock:
        sess = origin_sessions.get(origin)
        if sess is None or sess.closed:
            sess = ClientSession(
                cookie_jar=aiohttp.CookieJar(),
                timeout=ClientTimeout(total=None)
            )
            origin_sessions[origin] = sess
        return sess

async def close_all_origin_sessions():
    async with origin_lock:
        for sess in origin_sessions.values():
            if not sess.closed:
                await sess.close()
        origin_sessions.clear()

# ============================================================
# TCP handlers (concurrency‑safe)
# ============================================================
async def tcp_reader(sid, reader):
    try:
        while True:
            data = await reader.read(65536)
            if not data:
                break
            async with sessions_global_lock:
                sess = tcp_sessions.get(sid)
                if sess:
                    async with sess['lock']:
                        sess['buffer'].extend(data)
                        sess['last_access'] = time.time()
                    sess['data_event'].set()
    except Exception:
        pass
    finally:
        async with sessions_global_lock:
            sess = tcp_sessions.get(sid)
            if sess:
                async with sess['lock']:
                    sess['closed'] = True
                    sess['last_access'] = time.time()
                sess['data_event'].set()

async def handle_tcp_connect(req):
    sid = req["session_id"]; host = req["host"]; port = int(req["port"])
    try:
        r, w = await asyncio.wait_for(asyncio.open_connection(host, port), 15)
        sock = w.transport.get_extra_info('socket')
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 256*1024)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 256*1024)
        now = time.time()
        async with sessions_global_lock:
            tcp_sessions[sid] = {
                'reader': r, 'writer': w, 'buffer': bytearray(),
                'closed': False, 'last_access': now,
                'lock': asyncio.Lock(), 'data_event': asyncio.Event()
            }
        asyncio.create_task(tcp_reader(sid, r))
        return {"session_id": sid, "status": 200}
    except Exception as e:
        log.error("TCP connect %s:%d error: %s", host, port, e)
        return {"session_id": sid, "status": 500, "error": str(e)}

async def handle_tcp_data(req):
    sid = req["session_id"]; data = req.get("data", b"")
    async with sessions_global_lock:
        sess = tcp_sessions.get(sid)
    if sess:
        sess['writer'].write(data)
        await sess['writer'].drain()
        sess['last_access'] = time.time()

# ============================================================
# UDP handlers (concurrency‑safe)
# ============================================================
async def handle_udp_associate(req):
    sid = req["session_id"]
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind(('0.0.0.0', 0)); sock.setblocking(False)
    port = sock.getsockname()[1]
    async with sessions_global_lock:
        udp_sessions[sid] = {
            'socket': sock, 'pending': [], 'last_access': time.time(),
            'lock': asyncio.Lock(), 'data_event': asyncio.Event()
        }
    asyncio.create_task(udp_reader(sid, sock))
    return {"session_id": sid, "port": port}

async def udp_reader(sid, sock):
    loop = asyncio.get_event_loop()
    try:
        while True:
            data, addr = await loop.sock_recvfrom(sock, 65507)
            async with sessions_global_lock:
                sess = udp_sessions.get(sid)
                if sess:
                    async with sess['lock']:
                        sess['pending'].append((data, addr))
                        sess['last_access'] = time.time()
                    sess['data_event'].set()
    except Exception:
        pass

async def handle_udp_data(req):
    sid = req["session_id"]; data = req.get("data", b"")
    async with sessions_global_lock:
        sess = udp_sessions.get(sid)
    if sess:
        await asyncio.get_event_loop().sock_sendto(sess['socket'], data, (req["host"], int(req["port"])))
        sess['last_access'] = time.time()

# ============================================================
# WebSocket handlers (concurrency‑safe + client cleanup)
# ============================================================
async def handle_ws_connect(req):
    sid = req["session_id"]; host = req.get("host"); port = req.get("port", 443)
    path = req.get("path", "/")
    ws_url = f"wss://{host}:{port}{path}" if port == 443 else f"ws://{host}:{port}{path}"
    try:
        client = ClientSession()
        ws = await client.ws_connect(ws_url, headers=req.get("headers", {}), timeout=20)
        resp_headers = dict(ws.response.headers)
        async with sessions_global_lock:
            ws_sessions[sid] = {
                'ws': ws,
                'client': client,
                'buffer': [],
                'closed': False,
                'last_access': time.time(),
                'lock': asyncio.Lock(),
                'data_event': asyncio.Event()
            }
        asyncio.create_task(ws_reader(sid, ws))
        return {"session_id": sid, "status": 101, "headers": resp_headers}
    except Exception as e:
        log.error("WS connect error: %s", e)
        if 'client' in locals():
            await client.close()
        return {"session_id": sid, "status": 500, "error": str(e)}

async def ws_reader(sid, ws):
    try:
        async for msg in ws:
            data = msg.data if msg.type == WSMsgType.BINARY else msg.data.encode() if msg.type == WSMsgType.TEXT else None
            if data:
                async with sessions_global_lock:
                    sess = ws_sessions.get(sid)
                    if sess:
                        async with sess['lock']:
                            sess['buffer'].append(data)
                            sess['last_access'] = time.time()
                        sess['data_event'].set()
            elif msg.type in (WSMsgType.CLOSE, WSMsgType.ERROR):
                break
    except Exception:
        pass
    finally:
        async with sessions_global_lock:
            sess = ws_sessions.get(sid)
            if sess:
                async with sess['lock']:
                    sess['closed'] = True
                    sess['last_access'] = time.time()
                sess['data_event'].set()

async def handle_ws_data(req):
    sid = req["session_id"]; data = req.get("data", b"")
    async with sessions_global_lock:
        sess = ws_sessions.get(sid)
    if sess:
        try:
            await sess['ws'].send_bytes(data)
        except Exception:
            pass
        sess['last_access'] = time.time()

# ============================================================
# HTTP proxy with streaming (concurrency‑safe)
# ============================================================
async def proxy_http_request(req):
    method = req["method"]; url = req["url"]; headers = req.get("headers", {})
    body = req.get("body")
    parsed = urlparse(url); origin = f"{parsed.scheme}://{parsed.hostname}"
    out_headers = {k:v for k,v in headers.items() if k.lower() not in ("host","connection","proxy-connection","proxy-authorization","transfer-encoding")}
    should_stream = False
    resp = None
    try:
        client = await get_client_for_origin(origin)
        if req.get("_catflix_large_download") and method.upper() == "GET":
            try:
                async with client.head(url, headers=out_headers, timeout=15) as hresp:
                    clen = int(hresp.headers.get("Content-Length", 0))
                    if clen and hresp.headers.get("Accept-Ranges", "").lower() == "bytes":
                        return await handle_large_download_parallel(client, url, out_headers, clen)
            except Exception:
                pass

        resp = await client.request(method, url, headers=out_headers, data=body,
                                    timeout=ClientTimeout(total=None))
        content_length = resp.headers.get("Content-Length")
        is_chunked = resp.headers.get("Transfer-Encoding", "").lower() == "chunked"
        is_sse = "text/event-stream" in resp.headers.get("Content-Type", "")
        should_stream = (not content_length) or is_chunked or is_sse

        if not should_stream:
            body_bytes = await resp.read()
            test_obj = {"status": resp.status, "headers": dict(resp.headers), "body": body_bytes}
            test_plain = msgpack.dumps(test_obj, use_bin_type=True)
            test_enc = aes_enc(compress(test_plain))
            if len(test_enc) > MAX_ENCRYPTED_SIZE:
                status = resp.status
                headers_dict = dict(resp.headers)
                resp.release()
                return await split_large_response(status, headers_dict, body_bytes)
            return {"status": resp.status, "headers": dict(resp.headers), "body": body_bytes}

        # Streaming path
        stream_id = secrets.token_hex(8)
        now = time.time()
        async with sessions_global_lock:
            stream_sessions[stream_id] = {
                'buffer': [], 'closed': False, 'lock': asyncio.Lock(),
                'data_event': asyncio.Event(), 'headers': dict(resp.headers),
                'status': resp.status, 'total_chunks': None, 'chunk_index': 0,
                'last_access': now, 'origin_response': resp,
            }
        async def pump():
            try:
                async for chunk, _ in resp.content.iter_chunks():
                    async with sessions_global_lock:
                        sess = stream_sessions.get(stream_id)
                        if sess:
                            async with sess['lock']:
                                sess['buffer'].append(chunk)
                                sess['last_access'] = time.time()
                            sess['data_event'].set()
            except Exception:
                pass
            finally:
                resp.release()
                async with sessions_global_lock:
                    sess = stream_sessions.get(stream_id)
                    if sess:
                        async with sess['lock']:
                            sess['closed'] = True
                            sess['last_access'] = time.time()
                        sess['data_event'].set()
        asyncio.create_task(pump())
        return {"_stream": {"stream_id": stream_id, "chunk_index": 0, "total_chunks": None,
                            "headers": dict(resp.headers), "body": b"", "more": True}}
    except Exception as e:
        log.error("HTTP proxy error %s %s: %s", method, url[:80], e)
        if resp and not should_stream:
            try:
                resp.release()
            except Exception:
                pass
        return {"status": 502, "headers": {}, "body": f"Proxy error: {e}".encode()}
    finally:
        if resp and not should_stream:
            try:
                resp.release()
            except Exception:
                pass

async def handle_large_download_parallel(client, url, headers, content_length):
    stream_id = secrets.token_hex(8)
    total_chunks = (content_length + CHUNK_SIZE_DOWNLOAD - 1) // CHUNK_SIZE_DOWNLOAD
    now = time.time()
    sess = {
        'buffer': [], 'closed': False, 'lock': asyncio.Lock(),
        'data_event': asyncio.Event(), 'headers': {},
        'status': 200, 'total_chunks': total_chunks, 'chunk_index': 0,
        'last_access': now
    }
    async with sessions_global_lock:
        stream_sessions[stream_id] = sess

    async def fetch_chunk(start, end):
        hdrs = {**headers, "Range": f"bytes={start}-{end}"}
        try:
            async with client.get(url, headers=hdrs, timeout=30) as resp:
                if resp.status in (200, 206):
                    return await resp.read()
        except Exception:
            return None

    sem = asyncio.Semaphore(PARALLEL_RANGE_MAX)
    tasks = [asyncio.create_task(fetch_chunk(i * CHUNK_SIZE_DOWNLOAD,
                                             min((i + 1) * CHUNK_SIZE_DOWNLOAD, content_length) - 1))
             for i in range(total_chunks)]
    results = await asyncio.gather(*tasks)
    async with sess['lock']:
        for chunk in results:
            if chunk:
                sess['buffer'].append(chunk)
        sess['last_access'] = time.time()
        sess['closed'] = True
    sess['data_event'].set()
    return {"_stream": {"stream_id": stream_id, "chunk_index": 0, "total_chunks": total_chunks,
                        "headers": {"Content-Type": "application/octet-stream"}, "body": b"", "more": True}}

async def split_large_response(status, headers, body):
    stream_id = secrets.token_hex(8)
    now = time.time()
    sess = {
        'buffer': [], 'closed': False, 'lock': asyncio.Lock(),
        'data_event': asyncio.Event(), 'headers': headers,
        'status': status, 'total_chunks': None, 'chunk_index': 0,
        'last_access': now
    }
    async with sessions_global_lock:
        stream_sessions[stream_id] = sess
    chunk_size = 32768
    body_parts = [body[i:i + chunk_size] for i in range(0, len(body), chunk_size)]
    async def feeder():
        for part in body_parts:
            async with sess['lock']:
                if sess['closed']:
                    break
                sess['buffer'].append(part)
                sess['last_access'] = time.time()
                sess['data_event'].set()
            await asyncio.sleep(0)
        async with sess['lock']:
            sess['closed'] = True
            sess['last_access'] = time.time()
        sess['data_event'].set()
    asyncio.create_task(feeder())
    return {"_stream": {"stream_id": stream_id, "chunk_index": 0, "total_chunks": None,
                        "headers": headers, "body": b"", "more": True}}

# ============================================================
# Upload reassembly (unchanged, safe)
# ============================================================
async def handle_upload_chunk(req):
    uid = req["_catflix_upload"]; idx = req["_catflix_chunk"]; total = req["_catflix_total"]
    data = req.get("body", b"")
    if uid not in UPLOAD_BUFFERS:
        UPLOAD_BUFFERS[uid] = {"chunks": [None] * total, "total": total, "timestamp": time.time()}
    buf = UPLOAD_BUFFERS[uid]
    buf["chunks"][idx] = data
    if all(c is not None for c in buf["chunks"]):
        full_body = b"".join(buf["chunks"])
        del UPLOAD_BUFFERS[uid]
        new_req = {"method": req["method"], "url": req["url"], "headers": req.get("headers", {}),
                   "body": full_body}
        return await proxy_http_request(new_req)
    return None

# ============================================================
# Collect poll data (concurrency‑safe)
# ============================================================
async def collect_poll_results(sid_list):
    results = []
    now = time.time()
    async with sessions_global_lock:
        for sid in sid_list:
            # TCP
            sess = tcp_sessions.get(sid)
            if sess:
                async with sess['lock']:
                    buf = bytes(sess['buffer'])
                    sess['buffer'] = bytearray()
                    closed = sess['closed']
                    if buf or closed:
                        sess['last_access'] = now
                if buf or closed:
                    results.append({"session_id": sid, "data": buf, "closed": closed})
                    if closed:
                        try:
                            sess['writer'].close()
                        except Exception:
                            pass
                        del tcp_sessions[sid]
                continue

            # UDP
            sess = udp_sessions.get(sid)
            if sess:
                async with sess['lock']:
                    dgrams = sess['pending']
                    sess['pending'] = []
                    if dgrams:
                        sess['last_access'] = now
                if dgrams:
                    datagram_list = [{"host": addr[0], "port": addr[1], "data": d} for d, addr in dgrams]
                    results.append({"session_id": sid, "datagrams": datagram_list})
                continue

            # WebSocket
            sess = ws_sessions.get(sid)
            if sess:
                async with sess['lock']:
                    frames = sess['buffer']
                    sess['buffer'] = []
                    closed = sess['closed']
                    if frames or closed:
                        sess['last_access'] = now
                if frames or closed:
                    combined = b"".join(frames)
                    results.append({"session_id": sid, "type": "ws", "data": combined, "closed": closed})
                    if closed:
                        try:
                            await sess['ws'].close()
                        except Exception:
                            pass
                        try:
                            await sess['client'].close()
                        except Exception:
                            pass
                        del ws_sessions[sid]
                continue

            # Stream (live or large download)
            sess = stream_sessions.get(sid)
            if sess:
                async with sess['lock']:
                    chunks = sess['buffer']
                    sess['buffer'] = []
                    closed = sess['closed']
                    total = sess.get('total_chunks')
                    idx = sess['chunk_index']
                    if chunks:
                        sess['last_access'] = now
                for chunk_data in chunks:
                    more = not (closed and (total is not None and idx + 1 >= total))
                    results.append({
                        "_stream": {
                            "stream_id": sid,
                            "chunk_index": idx,
                            "total_chunks": total,
                            "headers": sess.get('headers', {}),
                            "body": chunk_data,
                            "more": more
                        }
                    })
                    idx += 1
                async with sess['lock']:
                    sess['chunk_index'] = idx
                    if closed and not chunks and (total is None or idx >= total):
                        if 'origin_response' in sess:
                            try:
                                sess['origin_response'].release()
                            except Exception:
                                pass
                        del stream_sessions[sid]
                continue
    return results

# ============================================================
# API handler
# ============================================================
async def api_handler(request: web.Request) -> web.Response:
    pending_responses = []
    try:
        if request.method == "POST":
            data = await request.json()
            q = data.get("q")
        else:
            q = request.query.get("q")
        if not q:
            raise web.HTTPBadRequest()

        enc = base64.urlsafe_b64decode(q)
        dec = aes_dec(enc)
        payload = decompress(dec)
        obj = msgpack.loads(payload, raw=False)

        for req in obj.get("requests", []):
            t = req.get("type")
            req_id = req.get("req_id")
            if t is None:
                if "_catflix_upload" in req:
                    resp = await handle_upload_chunk(req)
                    if resp is not None and req_id:
                        resp["req_id"] = req_id
                        pending_responses.append(resp)
                else:
                    resp = await proxy_http_request(req)
                    if req_id:
                        resp["req_id"] = req_id
                        pending_responses.append(resp)
            elif t == "tcp_connect":
                resp = await handle_tcp_connect(req)
                if req_id:
                    resp["req_id"] = req_id
                    pending_responses.append(resp)
            elif t == "tcp_data":
                await handle_tcp_data(req)
            elif t == "udp_associate":
                resp = await handle_udp_associate(req)
                if req_id:
                    resp["req_id"] = req_id
                    pending_responses.append(resp)
            elif t == "udp_data":
                await handle_udp_data(req)
            elif t == "ws_connect":
                resp = await handle_ws_connect(req)
                if req_id:
                    resp["req_id"] = req_id
                    pending_responses.append(resp)
            elif t == "ws_data":
                await handle_ws_data(req)

        poll_sids = obj.get("poll", [])
        start = time.monotonic()
        poll_results = []
        while not pending_responses and not poll_results and (time.monotonic() - start < LONG_POLL_TIMEOUT):
            new_data = await collect_poll_results(poll_sids)
            if new_data:
                poll_results.extend(new_data)
                break
            await asyncio.sleep(0.1)

        final_results = pending_responses + poll_results
        resp_obj = {"results": final_results}
        resp_plain = msgpack.dumps(resp_obj, use_bin_type=True)
        comp = compress(resp_plain)
        enc_resp = aes_enc(comp)
        padded = pad_response(enc_resp)
        return web.Response(body=padded, content_type="application/octet-stream")
    except Exception as e:
        log.exception("API error")
        return web.Response(status=500, text=str(e))

# ============================================================
# Cleanup (safe with locks and client close)
# ============================================================
async def cleanup_loop():
    while True:
        await asyncio.sleep(60)
        now = time.time()
        async with sessions_global_lock:
            for d in [tcp_sessions, udp_sessions, ws_sessions, stream_sessions]:
                for sid in list(d):
                    sess = d.get(sid)
                    if not sess:
                        continue
                    if now - sess.get('last_access', 0) > SESSION_TIMEOUT:
                        try:
                            if 'writer' in sess:
                                sess['writer'].close()
                            elif 'ws' in sess:
                                await sess['ws'].close()
                                if 'client' in sess:
                                    await sess['client'].close()
                            elif 'socket' in sess:
                                sess['socket'].close()
                            if 'origin_response' in sess:
                                sess['origin_response'].release()
                        except Exception:
                            pass
                        del d[sid]
            for uid in list(UPLOAD_BUFFERS):
                buf = UPLOAD_BUFFERS.get(uid)
                if buf and now - buf.get('timestamp', 0) > 300:
                    del UPLOAD_BUFFERS[uid]

app = web.Application()
app.router.add_route("GET", "/api", api_handler)
app.router.add_route("POST", "/api", api_handler)

if __name__ == "__main__":
    loop = asyncio.get_event_loop()
    loop.create_task(cleanup_loop())
    web.run_app(app, host="0.0.0.0", port=5000)
